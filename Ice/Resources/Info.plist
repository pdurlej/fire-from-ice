<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sparkle update feed for the Fire maintained fork of Ice.

	  Feed XML is served from a separate dedicated repository
	  (pdurlej/fire-releases) via GitHub Pages so that the source
	  repository (pdurlej/fire-from-ice) does not need to host static XML on a
	  branch. Each release's appcast entry is signed locally by the
	  maintainer with the matching EdDSA private key, which lives only in
	  the maintainer's macOS Keychain. Signing never happens in CI and
	  the key is not stored in any GitHub secret.

	  Replacing either of these values silently routes users to the
	  wrong update feed or breaks signature verification on every
	  install. Treat as load-bearing.
	-->
	<key>SUFeedURL</key>
	<string>https://pdurlej.github.io/fire-releases/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>JQ+doXtLQyWmGDao7dTzF4dNgnkSmAWmN66Ee/lw9Yc=</string>
</dict>
</plist>
